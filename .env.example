# Postgres
POSTGRES_USER=testinsights
POSTGRES_PASSWORD=testinsights
POSTGRES_DB=testinsights
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql+asyncpg://testinsights:testinsights@postgres:5432/testinsights
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Admin user (provisioned on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_FULL_NAME=Admin

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
